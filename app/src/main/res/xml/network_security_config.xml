<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- bcv.org.ve sends the wrong intermediate certificate and Android does not fetch the right one,
         so we ship it (Sectigo Public Server Authentication CA DV R36, valid until 2036). -->
    <domain-config>
        <domain includeSubdomains="true">bcv.org.ve</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/sectigo_dv_r36" />
        </trust-anchors>
    </domain-config>
</network-security-config>
